[Unit]
Description=Independent ABC lab common 7B adapter
After=network-online.target abc20261102-mqtt-tunnel.service

[Service]
Type=simple
WorkingDirectory=%h/abc20261102
EnvironmentFile=%h/abc20261102/.env
ExecStart=%h/abc20261102/.venv/bin/python -m lab.llm
Restart=on-failure
RestartSec=5
TimeoutStopSec=50

[Install]
WantedBy=default.target
